# Netlify: HTTP-Header
# Schriften und Bibliotheken ändern sich nie (Version im Dateinamen) -> lange cachen
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Interne Bereiche zusätzlich per Header von Suchmaschinen ausschließen
/portal.html
  X-Robots-Tag: noindex, nofollow
/dashboard.html
  X-Robots-Tag: noindex, nofollow
/admin.html
  X-Robots-Tag: noindex, nofollow
/404.html
  X-Robots-Tag: noindex
